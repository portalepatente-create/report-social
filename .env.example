# --- Meta (Facebook + Instagram) ---------------------------------------
# Token di accesso alla Pagina, preferibilmente di lunga durata (60 giorni).
META_ACCESS_TOKEN=
# ID numerico della Pagina Facebook (lascia vuoto per non includerla).
FACEBOOK_PAGE_ID=
# ID dell'account Instagram Business collegato (lascia vuoto per escluderlo).
INSTAGRAM_ACCOUNT_ID=

# --- Telegram ----------------------------------------------------------
# Token del bot, ottenuto da @BotFather.
TELEGRAM_BOT_TOKEN=
# ID della chat di destinazione (positivo per una chat privata,
# negativo per un gruppo o un canale; i supergruppi iniziano per -100).
TELEGRAM_CHAT_ID=
# Solo per i supergruppi con i Topic attivi: id del topic in cui scrivere.
# Lascia vuoto per la chat principale o per il topic "General".
TELEGRAM_MESSAGE_THREAD_ID=

# --- Opzionali ---------------------------------------------------------
# REPORT_TIMEZONE=Europe/Rome
# REPORT_DAYS=7
# META_GRAPH_VERSION=v21.0
# DRY_RUN=false
